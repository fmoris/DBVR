[gd_resource type="AudioBusLayout" format=3]

[sub_resource type="AudioEffectCapture" id="AudioEffectCapture_mic"]
resource_name = "Capture"
buffer_length = 0.25

[sub_resource type="AudioEffectAmplify" id="AudioEffectAmplify_mute"]
resource_name = "MuteOutput"
volume_db = -80.0

[resource]
bus/1/name = &"MicCapture"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = -80.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("AudioEffectCapture_mic")
bus/1/effect/0/enabled = true
bus/1/effect/1/effect = SubResource("AudioEffectAmplify_mute")
bus/1/effect/1/enabled = true
