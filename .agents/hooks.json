{
  "apk-auto-build": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"hooks/trigger_apk_build.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
