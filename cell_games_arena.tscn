[sub_resource type="Shader" id="Shader_fbjte"]
code = "
		shader_type spatial;
		
		uniform vec3 color_white : source_color = vec3(0.9, 0.9, 0.85);
		uniform vec3 color_green : source_color = vec3(0.3, 0.8, 0.4);
		uniform float grid_size = 16.0;

		void fragment() {
			// Creamos el patrón de cuadros matemáticamente usando las UVs
			vec2 grid_pos = floor(UV * grid_size);
			float checker = mod(grid_pos.x + grid_pos.y, 2.0);
			ALBEDO = mix(color_white, color_green, checker);
			ROUGHNESS = 0.8;
		}
	"

